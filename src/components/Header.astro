---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header" id="site-header">
  <a class="brand" href="/" aria-label={`${SITE.name} 主页`}>
    {SITE.name}<em>{SITE.nameEn}</em>
  </a>

  <nav class="site-nav" aria-label="主导航">
    {NAV.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="header-tools">
    <a
      class="tool-btn"
      href="/search/"
      aria-label="搜索"
      title="搜索"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-3.6-3.6" stroke-linecap="round"></path>
      </svg>
    </a>
    <button
      class="tool-btn"
      id="theme-toggle"
      type="button"
      aria-label="切换深色模式"
      title="切换深色模式"
    >
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>
