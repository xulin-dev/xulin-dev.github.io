---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" noindex>
  <div class="empty-state">
    <p class="code">404</p>
    <h1>这页不在这儿</h1>
    <p>链接可能过期了，或者地址敲错了。</p>
    <p style="margin-top:22px">
      <a class="section-more" href="/">回主页</a>
      &nbsp;·&nbsp;
      <a class="section-more" href="/search/">搜索一下</a>
    </p>
  </div>
</BaseLayout>
