---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime, allTags } from '../../lib/entries';

const posts = await getPosts();
const tags = allTags(posts).slice(0, 8);
---

<BaseLayout title="文章" description="单篇的完整问题记录：Linux、ZYNQ、嵌入式，从现象到结论。">
  <header class="page-head">
    <p class="kicker">Posts</p>
    <h1 class="page-title">文章</h1>
    <p class="page-desc">
      单篇的完整问题记录。通常是一件事从头到尾：现象、排查过程、最后落在哪一行配置或哪一段代码上。
    </p>
    <div class="page-meta">
      <span>{posts.length} 篇</span>
      {posts[0] && <span>最近更新 {formatDate(posts[0].data.date)}</span>}
    </div>
    {tags.length > 0 && (
      <ul class="tags" style="margin-top:16px">
        {tags.map((tag) => (
          <li><a href={`/search/?q=${encodeURIComponent(tag)}`}>{tag}</a></li>
        ))}
      </ul>
    )}
  </header>

  {posts.length === 0 ? (
    <p class="search-empty">还没有文章。</p>
  ) : (
    <ul class="entries">
      {posts.map((entry) => (
        <li>
          <a class="entry" href={`/posts/${entry.id}/`}>
            <span class="entry-date">{formatDate(entry.data.date)}</span>
            <span class="entry-main">
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
            </span>
            <span class="entry-side">
              <span>{readingTime(entry.body ?? '')} 分钟</span>
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
