---
import EntryLayout from '../../layouts/EntryLayout.astro';
import { render } from 'astro:content';
import { getPosts } from '../../lib/entries';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: posts[index - 1]
        ? { href: `/posts/${posts[index - 1].id}/`, title: posts[index - 1].data.title }
        : undefined,
      next: posts[index + 1]
        ? { href: `/posts/${posts[index + 1].id}/`, title: posts[index + 1].data.title }
        : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<EntryLayout kind="posts" entry={entry} headings={headings} prev={prev} next={next}>
  <Content />
</EntryLayout>
