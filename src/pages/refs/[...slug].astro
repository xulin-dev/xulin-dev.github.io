---
import EntryLayout from '../../layouts/EntryLayout.astro';
import { render } from 'astro:content';
import { getRefs } from '../../lib/entries';

export async function getStaticPaths() {
  const refs = await getRefs();
  return refs.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: refs[index - 1]
        ? { href: `/refs/${refs[index - 1].id}/`, title: refs[index - 1].data.title }
        : undefined,
      next: refs[index + 1]
        ? { href: `/refs/${refs[index + 1].id}/`, title: refs[index + 1].data.title }
        : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<EntryLayout kind="refs" entry={entry} headings={headings} prev={prev} next={next}>
  <Content />
</EntryLayout>
